# Copy to .env and fill in locally. NEVER commit real values.
#
# Both networks are configured, each with its OWN contract address and RPC.
# Addresses are per network and are never shared or guessed: a chain with no
# address shows a "not configured on this network" state.
#
# ONLY Ethereum Sepolia is our deployment + manual-verification target.
# Base Sepolia is supported/configurable for a separate deployment by someone
# who has Base Sepolia test ETH; we have NOT deployed to or verified it.

# --- Ethereum Sepolia (chain 11155111) — our target ---
# The client reads ALL level data from this contract at runtime.
VITE_SEPOLIA_CONTRACT_ADDRESS=
# Read-only RPC used for chain reads (level, leaderboard, ghost inputs).
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- Base Sepolia (chain 84532) — optional, not deployed/verified by us ---
# Address of a SpeedrunGhosts contract deployed on Base Sepolia (leave empty if none).
VITE_BASE_SEPOLIA_CONTRACT_ADDRESS=
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: default selected network on load. 11155111 (default) or 84532.
VITE_CHAIN_ID=
