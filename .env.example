# Copy to .env and fill in locally. NEVER commit real values.
# Used only by the Foundry deploy script (forge script ... --rpc-url ...).
#
# Ethereum Sepolia is our deployment + manual-verification target.
SEPOLIA_RPC_URL=
# Optional: only if you separately deploy the same contract on Base Sepolia.
BASE_SEPOLIA_RPC_URL=

# Deployer private key (0x-prefixed). Use a throwaway test key only.
PRIVATE_KEY=

# The deployed address for the network you deployed to (your own record; the
# front end reads its per-chain addresses from frontend/.env).
SEPOLIA_CONTRACT_ADDRESS=
BASE_SEPOLIA_CONTRACT_ADDRESS=

# Optional default network for the front end: 11155111 (default) or 84532.
CHAIN_ID=11155111
